# ---------------------------------------------------------------------------
# 디지털 교육 포털 환경 변수 예시 (Firebase)
# 실제 값은 이 파일에 넣지 말고 `.env.local`에 넣으세요. (.env.local 은 커밋되지 않습니다)
# 값은 Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) 의 firebaseConfig 에서 가져옵니다.
# ※ Firebase 웹 apiKey 는 비밀이 아니라 공개 식별자입니다. 실제 보호는
#    Firestore 보안 규칙(firestore.rules)과 승인된 도메인 설정이 담당합니다.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 파일 저장소(Storage)는 사용하지 않으므로 STORAGE_BUCKET 은 넣지 않습니다.
